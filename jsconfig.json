{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@test/*": ["test/*"],
      "@public/*": ["public/*"],
      "@fixtures/*": ["test/__fixtures__/*"],
      "@mocks/*": ["test/__mocks__/*"]
    }
  },
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "**/bower_components/*",
    "dist",
    "build",
    "out",
    ".cache",
    ".temp",
    "temp",
    "tmp",
    "**/*.tmp",
    "logs",
    "**/*.log",
    ".env*",
    ".idea",
    ".DS_Store",
    "Thumbs.db",
    "coverage",
    ".nyc_output",
    "*.lcov",
    "package-lock.json",
    "**/public/vendor/*",
    "**/public/libs/*",
    "**/*.min.js",
    "**/*.min.css",
    "**/webpack.config.override.js",
    "**/babel.config.override.js",
    ".history/",
    "**/*.txt",
    "Thursday-Jules.txt",
    "server_log.txt",
    "todo.md",
    "todo_possible_amendment.md",
    "readme.md",
    "ENVIRONMENT_INSTABILITY.md.errors",
    ".vscode/*",
    "archived_for_later_development/test/db/gameRepository.unit.test.js",
    "Repo_To_LLM",
    "archived_for_later_development"
  ],
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "test/**/*.js",
    "test/**/*.jsx",
    "public/js/**/*.js",
    "**/*.ts",
    "**/*.tsx",
    "**/__mocks__",
    "**/cypress",
    "**/e2e"
  ]
}
