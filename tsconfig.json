{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@test/*": ["test/*"],
      "@public/*": ["public/*"],
      "@fixtures/*": ["test/__fixtures__/*"],
      "@mocks/*": ["test/__mocks__/*"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./@types"
    ],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noImplicitAny": false,
    "strictNullChecks": true
  },
  "include": [
    "src/**/*.js",
    "test/**/*.js",
    "@types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "**/bower_components/*",
    "dist",
    "build",
    "out",
    ".cache",
    ".temp",
    "temp",
    "tmp",
    "**/*.tmp",
    "logs",
    "**/*.log",
    ".env*",
    ".idea",
    ".DS_Store",
    "Thumbs.db",
    "coverage",
    ".nyc_output",
    "*.lcov",
    "package-lock.json",
    "**/public/vendor/*",
    "**/public/libs/*",
    "**/*.min.js",
    "**/*.min.css",
    "**/webpack.config.override.js",
    "**/babel.config.override.js",
    ".history/",
    "**/*.txt",
    "Thursday-Jules.txt",
    "server_log.txt"
  ]
}
