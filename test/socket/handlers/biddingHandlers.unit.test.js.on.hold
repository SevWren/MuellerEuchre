/**
 * @file Unit tests for bidding socket handlers
 * @module test/socket/handlers/biddingHandlers.unit.test
 * @description
 *   Comprehensive test suite for bidding socket handlers using node:test and node:assert
 *   Layer 3 File (ON HOLD)
 *   Tests cover:
 *   - Handler registration
//  *   - Order up decision handling
 *   - Dealer discard handling
 *   - Error conditions and edge cases
 *   
 * @see {@link module:../../../src/socket/handlers/biddingHandlers} for implementation
 * @see {@link module:../../../src/game/phases/biddingPhase} for business logic
 * @see {@link module:../../../src/test-utils/test-helpers} for test utilities
 */

import { describe, it, beforeEach, afterEach, mock } from 'node:test';
import assert from 'node:assert/strict';
// Import test utilities first
import { 
  setupSocketTest, 
  setupTestState, 
  createMockPlayer, 
  createMockCard,
  createBaseGameState
} from '../../helpers/test-helpers.js'; //DO NOT CHANGE. THIS IS THE 100% confirmed correct path.
      
// Import game constants
import { 
  GAME_EVENTS, 
  GAME_PHASES, 
  PLAYER_POSITIONS, 
  PLAYER_ROLES, 
  SUITS, 
  TEAMS 
} from '../../../src/config/constants.js';  //DO NOT CHANGE. THIS IS THE 100% confirmed correct path.

// Import handlers under test
import { 
  handleOrderUpDecision, 
  handleCallTrumpDecision 
} from '../../../src/game/phases/biddingPhase.js';//DO NOT CHANGE. THIS IS THE 100% confirmed correct path.

import { handleDealerDiscard } from '../../src/game/phases/dealerDiscardPhase.js';//DO NOT CHANGE. THIS IS THE 100% confirmed correct path.
import { isValidBid, isValidDealerDiscard } from '../../../src/game/logic/validation-core.js';
import { logger } from '../../../src/utils/logger.js';//DO NOT CHANGE. THIS IS THE 100% confirmed correct path.
import * as biddingHandlers from '../../../src/socket/handlers/biddingHandlers.js';//DO NOT CHANGE. THIS IS THE 100% confirmed correct path.

// Test constants
const GAME_ID = 'test-game-123';
const USER_ID = 'user-123';
const PLAYER_ROLE = PLAYER_POSITIONS.PLAYER_SOUTH;
const PLAYER_SOCKET_ID = 'socket-south';

// Create test cards using helper
const createTestCard = (value, suit, isTurnCard = false) => ({
  id: `${value}${suit[0].toUpperCase()}`,
  value,
  suit,
  name: `${value} of ${suit}`,
  isTurnCard
});

// Base test state using helper
const createTestState = (overrides = {}) => {
  const baseState = createBaseGameState({
    gameId: GAME_ID,
    dealer: overrides.dealer || PLAYER_ROLE,
    currentPlayer: overrides.currentPlayer || PLAYER_ROLE,
    gamePhase: overrides.gamePhase || GAME_PHASES.ORDER_UP_ROUND1
  });
  
  // Add players with test hands
  const players = {};
  [
    { role: PLAYER_POSITIONS.PLAYER_SOUTH, team: TEAMS.TEAM_NS, socketId: 'socket-south' },
    { role: PLAYER_POSITIONS.PLAYER_WEST, team: TEAMS.TEAM_EW, socketId: 'socket-west' },
    { role: PLAYER_POSITIONS.PLAYER_NORTH, team: TEAMS.TEAM_NS, socketId: 'socket-north' },
    { role: PLAYER_POSITIONS.PLAYER_EAST, team: TEAMS.TEAM_EW, socketId: 'socket-east' }
  ].forEach(({ role, team, socketId }) => {
    players[role] = createMockPlayer(role, {
      id: `user-${role.toLowerCase()}`,
      teamId: team,
      socketId,
      hand: [
        createTestCard('A', SUITS.HEARTS),
        createTestCard('K', SUITS.HEARTS),
        createTestCard('Q', SUITS.HEARTS),
        createTestCard('J', SUITS.HEARTS),
        createTestCard('10', SUITS.HEARTS)
      ]
    });
  });

  return {
    ...baseState,
    ...overrides,
    players,
    turnCard: overrides.turnCard || createTestCard('9', SUITS.HEARTS, true),
    gameStarted: true,
    currentTrick: [],
    trickHistory: [],
    scores: { [TEAMS.TEAM_NS]: 0, [TEAMS.TEAM_EW]: 0 },
    playerWhoOrderedUp: null,
    trumpSuit: null,
    goAlone: { [TEAMS.TEAM_NS]: false, [TEAMS.TEAM_EW]: false },
    playerWhoCalledTrump: null
  };
};

// Setup test environment
let testContext;
let mockSocket;
let mockIo;
let mockGameRepository;
let handleOrderUpDecisionStub;
let handleDealerDiscardStub;
let handleCallTrumpDecisionStub;
let isValidBidStub;
let isValidDealerDiscardStub;

/**
 * Helper function to get a registered handler for testing
 * @param {string} eventName - The event name to get the handler for
 * @returns {Function} The registered event handler
 */
function getHandlerForEventTesting(eventName) {
  // Initialize handlers with test context
  biddingHandlers.initializeBiddingHandlers({
    io: mockIo,
    socket: mockSocket,
    gameRepository: mockGameRepository
  });
  
  // Find the handler for our event
  const eventHandler = mockSocket.on.mock.calls
    .find(call => call[0] === eventName);
  
  if (!eventHandler) {
    throw new Error(`No handler registered for event: ${eventName}`);
  }
  
  return eventHandler[1];
}

describe('Bidding Socket Handlers', () => {
  beforeEach(async () => {
    // Setup test context with socket test utilities
    testContext = setupSocketTest({
      socketId: PLAYER_SOCKET_ID,
      playerRole: PLAYER_ROLE,
      gameState: createTestState()
    });
    
    mockSocket = testContext.mockSocket;
    mockIo = testContext.mockIo;
    mockGameRepository = testContext.mockGameRepository;
    
    // Setup default mock implementations
    handleOrderUpDecisionStub = mock.fn();
    handleDealerDiscardStub = mock.fn();
    handleCallTrumpDecisionStub = mock.fn();
    isValidBidStub = mock.fn().mockReturnValue({ isValid: true });
    isValidDealerDiscardStub = mock.fn().mockReturnValue({ isValid: true });
    
    // Mock module imports with our stubs
    mock.module('../../../src/game/phases/biddingPhase', () => ({
      handleOrderUpDecision: handleOrderUpDecisionStub,
      handleCallTrumpDecision: handleCallTrumpDecisionStub,
      handleDealerDiscard: handleDealerDiscardStub
    }));
    
    mock.module('../../../src/game/logic/validation', () => ({
      isValidBid: isValidBidStub,
      isValidDealerDiscard: isValidDealerDiscardStub,
      validatePlay: mock.fn().mockReturnValue({ isValid: true })
    }));
    
    // Setup default mock implementations for repository
    mockGameRepository.getGame.mockImplementation((gameId) => {
      return Promise.resolve(createTestState({ gameId }));
    });
    
    mockGameRepository.updateGame.mockImplementation((gameId, state) => {
      return Promise.resolve(state);
    });
  });
  
  afterEach(() => {
    // Clean up any global mocks
    mock.restoreAll();
  });

  afterEach(() => {
    // Clean up all mocks
    mock.restoreAll();
  });
  
  describe('registerBiddingHandlers', () => {
    it('should register all required event handlers', async () => {
      // Import the module (will use our mocks)
      const { registerBiddingHandlers } = await import('../../src/socket/handlers/biddingHandlers');
      // Spy on socket.on
      const onSpy = mock.method(mockSocket, 'on');
      
      // Register the handlers
      registerBiddingHandlers(mockSocket, mockIo);
      
      // Get all registered events
      const registeredEvents = onSpy.mock.calls.map(([event]) => event);
      
      // Verify all required events are registered
      const requiredEvents = [
        GAME_EVENTS.ACTION_ORDER_UP_DECISION,
        GAME_EVENTS.ACTION_DEALER_DISCARD,
        GAME_EVENTS.ACTION_CALL_TRUMP_DECISION
      ];
      
      requiredEvents.forEach(event => {
        assert.ok(
          registeredEvents.includes(event),
          `Should register handler for ${event}`
        );
      });
    });
  });

  describe('handleOrderUpDecision', () => {
    const DECISION = {
      orderUp: true,
      suit: SUITS.HEARTS,
      goAlone: false
    };

    let handler;

    beforeEach(async () => {
      // Setup initial game state for order up
      const testState = createTestState({
        gamePhase: GAME_PHASES.ORDER_UP_ROUND1
      });
      
      // Setup next game state
      const nextState = {
        ...testState,
        trumpSuit: SUITS.HEARTS,
        makerTeam: TEAMS.TEAM_NS,
        gamePhase: GAME_PHASES.DEALER_DISCARD
      };
      
      // Setup handler
      handler = await getHandlerForEventTesting(GAME_EVENTS.ACTION_ORDER_UP_DECISION);
      
      // Setup stubs
      handleOrderUpDecisionStub.mockReturnValue(nextState);
      mockGameRepository.getGame.mockResolvedValue(testState);
    });

    it('should successfully process valid order up decision (ordering up)', async () => {
      // Setup mocks
      const ackSpy = mock.fn();
      const data = { gameId: GAME_ID, decision: 'orderUp' };

      // Execute handler
      await handler(data, ackSpy);

      // Verify repository interactions
      assert.strictEqual(mockGameRepository.getGame.mock.calls.length, 1, 'getGame should be called once');
      assert.strictEqual(mockGameRepository.getGame.mock.calls[0][0], GAME_ID, 'getGame should be called with correct gameId');

      // Verify phase handler was called correctly
      assert.strictEqual(handleOrderUpDecisionStub.mock.calls.length, 1, 'handleOrderUpDecision should be called once');
      const phaseArgs = handleOrderUpDecisionStub.mock.calls[0];
      assert.strictEqual(phaseArgs[0].gameId, GAME_ID, 'Should pass correct game state');
      assert.strictEqual(phaseArgs[1], PLAYER_ROLE, 'Should pass correct player role');
      assert.strictEqual(phaseArgs[2], true, 'Should pass orderUp=true');

      // Verify game update
      assert.strictEqual(mockGameRepository.updateGame.mock.calls.length, 1, 'updateGame should be called once');
      const updateArgs = mockGameRepository.updateGame.mock.calls[0];
      assert.strictEqual(updateArgs[0], GAME_ID, 'Should update correct game');
      assert.strictEqual(updateArgs[1].gameId, GAME_ID, 'Should update with new game state');
      assert.strictEqual(updateArgs[1].trumpSuit, SUITS.HEARTS, 'Should update with new trump suit');

      // Verify socket emission
      assert.strictEqual(mockIo.to.mock.calls.length, 1, 'io.to should be called once');
      assert.strictEqual(mockIo.to.mock.calls[0][0], GAME_ID, 'Should emit to correct game room');
      
      assert.strictEqual(mockIo.emit.mock.calls.length, 1, 'io.emit should be called once');
      const emitArgs = mockIo.emit.mock.calls[0];
      assert.strictEqual(emitArgs[0], GAME_EVENTS.STATE_UPDATE, 'Should emit STATE_UPDATE event');
      assert.strictEqual(emitArgs[1].gameId, GAME_ID, 'Should emit updated game state');
      assert.strictEqual(emitArgs[1].trumpSuit, SUITS.HEARTS, 'Should emit new trump suit');

      // Verify acknowledgment
      assert.strictEqual(ackSpy.mock.calls.length, 1, 'Ack should be called once');
      const ackFirstArg = ackSpy.mock.calls[0][0];
      const ackSecondArg = ackSpy.mock.calls[0][1];
      assert.strictEqual(ackFirstArg, null, 'Ack should be called with null error');
      assert.deepStrictEqual(
        ackSecondArg, 
        { status: 'ok', message: 'Order up decision processed.' },
        'Ack should be called with success response'
      );
      
      // Verify no errors were logged
      assert.strictEqual(logger.error.mock.calls.length, 0, 'No errors should be logged');
    });

    it('should successfully process valid order up decision (passing)', async () => {
      // Arrange
      const nextState = {
        ...createTestState({
          gamePhase: GAME_PHASES.ORDER_UP_ROUND1
        }),
        currentPlayer: PLAYER_POSITIONS.PLAYER_WEST
      };
      handleOrderUpDecisionStub.mockReturnValue(nextState);
      const ackSpy = mock.fn();
      const data = { gameId: GAME_ID, decision: 'pass' };

      // Act
      await handler(data, ackSpy);

      // Assert
      expect(handleOrderUpDecisionStub).to.have.been.calledOnce;
      expect(handleOrderUpDecisionStub.getCall(0).args[2]).to.equal(false);
      expect(ackSpy).to.have.been.calledOnceWithExactly({
        status: 'success',
        gameState: nextState,
        message: 'Order up decision processed successfully'
      });
    });

    it('should handle errors during order up decision processing', async () => {
      // Arrange
      const error = new Error('Test error');
      handleOrderUpDecisionStub.throws(error);
      const ackSpy = mock.fn();
      const data = { gameId: GAME_ID, decision: 'pass' };

      // Act
      await handler(data, ackSpy);

      // Assert
      expect(handleOrderUpDecisionStub).to.have.been.calledOnce;
      expect(ackSpy).to.have.been.calledOnceWithExactly({
        status: 'error',
        message: error.message,
        error: error
      });
    });

    it('should handle error if playerRole is not the current player in gameState (via isValidBid mock)', async () => {
        isValidBidStub.returns({ isValid: false, message: 'Not your turn.' });
        const ackSpy = mock.fn();
        await handler({ gameId: GAME_ID, decision: 'pass' }, ackSpy);

        assert.strictEqual(ackSpy.mock.calls.length, 1, 'Callback should be called once');
        assert.deepStrictEqual(ackSpy.mock.calls[0][0], { status: 'error', message: 'Not your turn.' });
        assert.strictEqual(handleOrderUpDecisionStub.mock.calls.length, 0, 'handleOrderUpDecision should not be called');
    });

    it('should handle invalid data payload (missing decision)', async () => {
        const ackSpy = mock.fn();
        await handler({ gameId: GAME_ID }, ackSpy);
        assert.strictEqual(ackSpy.mock.calls.length, 1, 'Callback should be called once');
        expect(ackSpy.getCall(0).args[0]).to.deep.include({ status: 'error', message: 'Invalid decision data: gameId and decision string required.' });
    });
  });

  describe('handleDealerDiscard', () => {
    const CARD_TO_DISCARD = createTestCard('A', SUITS.HEARTS);
    const TURN_CARD = createTestCard('J', SUITS.SPADES, true);
    let handler;
    let testGameState;

    beforeEach(async () => {
      // Create a test state for dealer discard scenario
      testGameState = createTestState({
        gamePhase: GAME_PHASES.DEALER_DISCARD,
        dealer: PLAYER_ROLE,
        currentPlayer: PLAYER_ROLE,
        turnCard: TURN_CARD,
        players: {
          [PLAYER_ROLE]: {
            ...createMockPlayer(PLAYER_ROLE, {
              id: USER_ID,
              teamId: TEAMS.TEAM_NS,
              socketId: PLAYER_SOCKET_ID,
              hand: [CARD_TO_DISCARD, createTestCard('K', SUITS.HEARTS)]
            })
          }
        }
      });
      
      // Setup next game state after discard
      const nextState = {
        ...testGameState,
        turnCard: null,
        players: {
          ...testGameState.players,
          [PLAYER_ROLE]: {
            ...testGameState.players[PLAYER_ROLE],
            hand: [TURN_CARD] // Card was picked up, discard was removed
          }
        },
        gamePhase: GAME_PHASES.PLAYING
      };
      
      // Configure mocks
      mockGameRepository.getGame.mockResolvedValue(testGameState);
      handleDealerDiscardStub.mockReturnValue(nextState);
      
      // Get the handler for testing
      handler = await getHandlerForEventTesting(GAME_EVENTS.ACTION_DEALER_DISCARD);
    });

    it('should process a valid dealer discard', async () => {
      // Setup test data
      const ackSpy = mock.fn();
      const data = { 
        gameId: GAME_ID,
        cardId: CARD_TO_DISCARD.id 
      };
      
      // Call the handler
      await handler(data, ackSpy);
      
      // Verify validation was called with correct arguments
      assert.strictEqual(
        isValidDealerDiscardStub.mock.calls.length, 
        1, 
        'Should validate the discard'
      );
      
      const [validationGameState, validationCardId, validationPlayerRole] = isValidDealerDiscardStub.mock.calls[0];
      assert.strictEqual(validationGameState.gameId, GAME_ID, 'Validation should receive correct game state');
      assert.strictEqual(validationCardId, data.cardId, 'Validation should receive correct card ID');
      assert.strictEqual(validationPlayerRole, PLAYER_ROLE, 'Validation should receive correct player role');
      
      // Verify the handler was called with correct arguments
      assert.strictEqual(
        handleDealerDiscardStub.mock.calls.length, 
        1, 
        'Should call handleDealerDiscard'
      );
      
      const [gameState, cardId, dealerRole] = handleDealerDiscardStub.mock.calls[0];
      assert.strictEqual(
        gameState.gameId, 
        GAME_ID, 
        'Should pass current game state'
      );
      assert.strictEqual(
        cardId, 
        data.cardId, 
        'Should pass the card ID to discard'
      );
      assert.strictEqual(
        dealerRole, 
        PLAYER_ROLE, 
        'Should pass the dealer role'
      );
      
      // Verify the game was updated
      assert.strictEqual(
        mockGameRepository.updateGame.mock.calls.length, 
        1, 
        'Should update the game state'
      );
      
      const [updateGameId, updatedState] = mockGameRepository.updateGame.mock.calls[0];
      assert.strictEqual(updateGameId, GAME_ID, 'Should update correct game');
      assert.strictEqual(updatedState.gamePhase, GAME_PHASES.PLAYING, 'Should transition to playing phase');
      
      // Verify the acknowledgment was called with success
      assert.strictEqual(
        ackSpy.mock.calls.length, 
        1, 
        'Should call the acknowledgment callback'
      );
      
      const ackResponse = ackSpy.mock.calls[0][0];
      assert.strictEqual(ackResponse.status, 'success', 'Should indicate success');
      assert.match(ackResponse.message, /discard processed/i, 'Should include success message');
      
      // Verify the game state was emitted to the room
      const emitCalls = mockIo.to().emit.mock.calls;
      assert.strictEqual(
        emitCalls.length, 
        1, 
        'Should emit state update to game room'
      );
      
      const [eventName, eventData] = emitCalls[0];
      assert.strictEqual(
        eventName, 
        GAME_EVENTS.STATE_UPDATE, 
        'Should emit STATE_UPDATE event'
      );
      assert.strictEqual(
        eventData.gamePhase, 
        GAME_PHASES.PLAYING, 
        'Should emit updated game phase'
      );
    });

    it('should handle error if player is not the dealer', async () => {
      // Setup test data with different dealer
      const nonDealerRole = PLAYER_POSITIONS.PLAYER_NORTH;
      testGameState.dealer = nonDealerRole;
      testGameState.currentPlayer = nonDealerRole;
      
      // Mock validation to fail with not dealer error
      isValidDealerDiscardStub.returns({ 
        isValid: false, 
        message: 'Only the dealer can discard.',
        errorCode: 'NOT_DEALER'
      });
      
      const ackSpy = mock.fn();
      
      // Call the handler
      await handler({ 
        gameId: GAME_ID,
        cardId: CARD_TO_DISCARD.id 
      }, ackSpy);
      
      // Verify validation was called
      assert.strictEqual(
        isValidDealerDiscardStub.mock.calls.length, 
        1, 
        'Should validate the discard'
      );
      
      // Verify the handler was not called
      assert.strictEqual(
        handleDealerDiscardStub.mock.calls.length, 
        0, 
        'Should not call handleDealerDiscard for non-dealer'
      );
      
      // Verify the acknowledgment was called with error
      assert.strictEqual(
        ackSpy.mock.calls.length, 
        1, 
        'Should call the acknowledgment callback'
      );
      
      const ackResponse = ackSpy.mock.calls[0][0];
      assert.strictEqual(ackResponse.status, 'error', 'Should indicate error');
      assert.match(ackResponse.message, /only the dealer can discard/i, 'Should include error message');
      assert.strictEqual(ackResponse.errorCode, 'NOT_DEALER', 'Should include error code');
      
      // Verify no state updates were emitted
      assert.strictEqual(
        mockIo.to().emit.mock.calls.length, 
        0, 
        'Should not emit state update for invalid discard'
      );
    });
    
    it('should handle invalid card ID', async () => {
      // Mock validation to fail with invalid card error
      isValidDealerDiscardStub.returns({ 
        isValid: false, 
        message: 'Invalid card ID',
        errorCode: 'INVALID_CARD'
      });
      
      const ackSpy = mock.fn();
      
      // Call with invalid card ID
      await handler({ 
        gameId: GAME_ID,
        cardId: 'INVALID_CARD_ID' 
      }, ackSpy);
      
      // Verify validation was called
      assert.strictEqual(
        isValidDealerDiscardStub.mock.calls.length, 
        1, 
        'Should validate the discard'
      );
      
      // Verify the handler was not called
      assert.strictEqual(
        handleDealerDiscardStub.mock.calls.length, 
        0, 
        'Should not call handleDealerDiscard with invalid card'
      );
      
      // Verify the acknowledgment was called with error
      assert.strictEqual(
        ackSpy.mock.calls.length, 
        1, 
        'Should call the acknowledgment callback'
      );
      
      const ackResponse = ackSpy.mock.calls[0][0];
      assert.strictEqual(ackResponse.status, 'error', 'Should indicate error');
      assert.match(ackResponse.message, /invalid card/i, 'Should include error message');
      assert.strictEqual(ackResponse.errorCode, 'INVALID_CARD', 'Should include error code');
      
      // Verify no state updates were emitted
      assert.strictEqual(
        mockIo.to().emit.mock.calls.length, 
        0, 
        'Should not emit state update for invalid card'
      );
    });
    
    it('should handle repository errors', async () => {
      // Mock repository to throw an error
      const testError = new Error('Database error');
      mockGameRepository.getGame.mockRejectedValueOnce(testError);
      
      const ackSpy = mock.fn();
      
      // Call the handler
      await handler({ 
        gameId: GAME_ID,
        cardId: CARD_TO_DISCARD.id 
      }, ackSpy);
      
      // Verify the acknowledgment was called with error
      assert.strictEqual(
        ackSpy.mock.calls.length, 
        1, 
        'Should call the acknowledgment callback'
      );
      
      const ackResponse = ackSpy.mock.calls[0][0];
      assert.strictEqual(ackResponse.status, 'error', 'Should indicate error');
      assert.match(ackResponse.message, /error processing discard/i, 'Should include error message');
      assert.strictEqual(ackResponse.error, testError, 'Should include the original error');
      
      // Verify no state updates were emitted
      assert.strictEqual(
        mockIo.to().emit.mock.calls.length, 
        0, 
        'Should not emit state update on repository error'
      );
    });
  });
  
  describe('handleCallTrumpDecision', () => {
    let handler;
    let testGameState;
    
    beforeEach(async () => {
      // Create a test state for call trump scenario
      testGameState = createTestState({
        gamePhase: GAME_PHASES.CALL_TRUMP,
        dealer: PLAYER_ROLE,
        currentPlayer: PLAYER_ROLE,
        players: {
          [PLAYER_ROLE]: {
            ...createMockPlayer(PLAYER_ROLE, {
              id: USER_ID,
              teamId: TEAMS.TEAM_NS,
              socketId: PLAYER_SOCKET_ID,
              hand: [
                createTestCard('A', SUITS.CLUBS),
                createTestCard('K', SUITS.DIAMONDS),
                createTestCard('Q', SUITS.HEARTS),
                createTestCard('J', SUITS.SPADES),
                createTestCard('10', SUITS.CLUBS)
              ]
            })
          }
        }
      });
      
      // Configure mocks
      mockGameRepository.getGame.mockResolvedValue(testGameState);
      handleCallTrumpDecisionStub.mockReturnValue({
        ...testGameState,
        trumpSuit: SUITS.HEARTS,
        gamePhase: GAME_PHASES.PLAYING
      });
      
      // Get the handler for testing
      handler = await getHandlerForEventTesting(GAME_EVENTS.ACTION_CALL_TRUMP_DECISION);
    });
    
    it('should process a valid call trump decision', async () => {
      const ackSpy = mock.fn();
      const data = {
        gameId: GAME_ID,
        decision: 'call',
        suit: SUITS.HEARTS,
        goAlone: false
      };
      
      // Call the handler
      await handler(data, ackSpy);
      
      // Verify validation was called
      assert.strictEqual(
        isValidBidStub.mock.calls.length, 
        1, 
        'Should validate the bid'
      );
      
      // Verify the handler was called with correct arguments
      assert.strictEqual(
        handleCallTrumpDecisionStub.mock.calls.length, 
        1, 
        'Should call handleCallTrumpDecision'
      );
      
      const [gameState, decision, suit, goAlone] = handleCallTrumpDecisionStub.mock.calls[0];
      assert.strictEqual(gameState.gameId, GAME_ID, 'Should pass game state');
      assert.strictEqual(decision, 'call', 'Should pass decision');
      assert.strictEqual(suit, SUITS.HEARTS, 'Should pass suit');
      assert.strictEqual(goAlone, false, 'Should pass goAlone flag');
      
      // Verify the game was updated
      assert.strictEqual(
        mockGameRepository.updateGame.mock.calls.length, 
        1, 
        'Should update the game state'
      );
      
      // Verify the acknowledgment was called with success
      assert.strictEqual(
        ackSpy.mock.calls.length, 
        1, 
        'Should call the acknowledgment callback'
      );
      
      const ackResponse = ackSpy.mock.calls[0][0];
      assert.strictEqual(ackResponse.status, 'success', 'Should indicate success');
      
      // Verify the game state was emitted to the room
      const emitCalls = mockIo.to().emit.mock.calls;
      assert.strictEqual(
        emitCalls.length, 
        1, 
        'Should emit state update to game room'
      );
      
      const [eventName, eventData] = emitCalls[0];
      assert.strictEqual(
        eventName, 
        GAME_EVENTS.STATE_UPDATE, 
        'Should emit STATE_UPDATE event'
      );
      assert.strictEqual(
        eventData.gamePhase, 
        GAME_PHASES.PLAYING, 
        'Should emit updated game phase'
      );
    });
  });
});