# Set default behavior to automatically handle line endings.
* text=auto

# Explicitly declare files that should always have LF endings.
# This is good practice for most text-based source files.
*.js      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.txt     text eol=lf

# Explicitly declare files that must have CRLF endings.
*.bat     text eol=crlf