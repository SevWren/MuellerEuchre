{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@/*": ["src/*"],
      "@test/*": ["test/*"],
      "@public/*": ["public/*"]
    }
  },
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "**/bower_components/*",
    "assets",
    "dist",
    "build",
    "out",
    ".cache",
    ".temp",
    "temp",
    "tmp",
    "**/*.tmp",
    "logs",
    "**/*.log",
    ".env*",
    ".idea",
    ".DS_Store",
    "Thumbs.db",
    "coverage",
    ".nyc_output",
    "*.lcov",
    "package-lock.json",
    "**/public/vendor/*",
    "**/public/libs/*",
    "**/*.min.css",
    "**/webpack.config.override.js",
    "**/babel.config.override.js",
    ".history/",
    "**/*.txt",
    "Thursday-Jules.txt",
    "server_log.txt",
    "todo.md",
    "todo_possible_amendment.md",
    "readme.md",
    ".vscode/*",
    "archived_for_later_development/test/db/gameRepository.unit.test.js",
    "Repo_To_LLM",
    "mueller_euchre_repo_llm.txt",
    "MuellerEuchre-Windsurf.code-workspace",

    "archived_for_later_development"
  ],
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "test/**/*.js",
    "test/**/*.jsx",
    "public/js/**/*.js",
    "**/cypress",
    "**/e2e"
  ]
}
