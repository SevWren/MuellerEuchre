{
  "name": "euchre-multiplayer",
  "version": "1.0.0",
  "description": "Multiplayer Euchre Game Server",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=v20.1.0"
  },
  "scripts": {
    "test": "node --test --test-reporter spec",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test:file": "node --test --timeout 15000",
    "test:watch": "node --test --watch --timeout 10000",
    "test:debug": "node --inspect node --test --timeout 10000",
    "test:decktests": "node Scripts/run-deck-dependent-tests.js",
    "test:decktestsdealer": "node Scripts/run-deck-dependent-tests.js",
    "test:coverage:file": "node Scripts/run-coverage-on-file.js",
    "test:coverage": "c8 --clean node --test --test-reporter spec",
    "test:coverage_layer1_depreciated": "npm run clean:coverage && c8 mocha test/game/**/*.test.js test/utils/**/*.test.js --recursive --timeout 10000",
    "coverage:report": "npx c8 report --reporter=text-lcov | npx coveralls",
    "test:coverage:goalone": "npx c8 --clean --reporter=text --reporter=html --include \"src/game/phases/goAlonePhase.js\" node --test test/game/phases/goAlonePhase.unit.test.js test/game/phases/goAlonePhase.edge.unit.test.js",
    "test:coverage:validation": "node Scripts/run.validation.coverage.report.js",
    "test:coverage:validate_goalone": "npx c8 --clean --reporter=text --reporter=html --include \"src/game/logic/validation.js\" node --test test/game/logic/validation.GoAlone.unit.test.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js,.jsx --fix",
    "prettier": "prettier --write .",
    "prepare": "husky install",
    "init:modules": "node init-modules.js",
    "test:diag:basic": "NODE_OPTIONS=\"--trace-warnings\" mocha test/server/basic.unit.test.js"
  },
  "c8": {
    "exclude": [
      "**/test/**",
      "**/node_modules/**",
      "**/coverage/**",
      "**/public/**",
      "**/.git/**",
      "**/Repo_To_LLM/**"
    ],
    "include": [
      "src/game/logic/**/*.js",
      "src/helpers/**/*.js",
      "src/game/phases/**/*.js",
      "src/utils/**/*.js",
      "src/config/**/*.js"
    ],
    "reporter": [
      "text",
      "html",
      "lcov"
    ],
    "all": true
  },
  "keywords": [
    "euchre",
    "card-game",
    "multiplayer",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "5.1.0",
    "mongodb": "^6.16.0",
    "nanoid": "^5.1.5",
    "pino": "^8.19.0",
    "socket.io": "^4.7.2"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.5",
    "@types/supertest": "^6.0.2",
    "c8": "^8.0.0",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "esm": "^3.2.25",
    "husky": "^8.0.3",
    "jsonc-parser": "^3.3.1",
    "lint-staged": "^15.0.2",
    "mocha": "^11.0.0",
    "nodemon": "^3.1.0",
    "npm-run-all": "^4.1.5",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.10",
    "socket.io-client": "^4.7.2",
    "supertest": "^6.3.3"
  }
}
