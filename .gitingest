# This is a TOML file used by the gitingest tool.
# Patterns listed here will be excluded from the context file generation.

exclude-pattern = [
  # Core Dependencies & Build Output
  "node_modules/",
  "package-lock.json",
  "dist/",
  "build/",
  "out/",

  # Version Control & CI/CD
  ".git/",
  ".github/",
  ".husky/",

  # Test & Coverage Artifacts
  "coverage/",
  ".nyc_output",
  "*.lcov",
  "full_test_out.txt",
  "unit_test_results.txt",
  "players.unit.test.js_100_percent.txt",

  # Local & Editor Configuration
  ".vscode/",
  ".idea/",
  ".DS_Store",
  "Thumbs.db",
  ".windsurf/",
  ".kilocode",
  ".kilocodemodes",

  # Project-Specific & Archived Directories
  "archived/",
  "archived_for_later_development/",
  "Repo_To_LLM/",
  "Prompts/",
  "memory-bank/",
  "tools/",
  
  # Public Assets (as requested)
  "public/",
  "assets/",

  # Specific Config & Backup Files
  ".markdownlint.json",
  ".mocharc - Copy.cjs.txt",
  ".mocharc.js.bak",

  # Documentation Files (as requested)
  "CODE_OF_CONDUCT.md",

  # Log files and temporary files
  "*.log",
  "logs/",
  "server_log.txt",
  "*.tmp",
  "tmp/",
  "temp/",

  # Tool's own output file
  "mueller_euchre_repo_llm.txt",
]